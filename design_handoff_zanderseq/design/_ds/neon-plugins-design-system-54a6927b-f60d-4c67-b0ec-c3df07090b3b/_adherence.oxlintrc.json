{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/buttons/**",
              "components/controls/**",
              "components/surfaces/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|active|glow|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: label, value, color, active, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dial'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|color|label|size|format|sensitivity|key|ref|className|style|children)$/]",
        "message": "<Dial> doesn't accept that prop. Declared props: value, onChange, color, label, size, format, sensitivity."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|engaged|variant|idleLabel|key|ref|className|style|children)$/]",
        "message": "<GlowButton> doesn't accept that prop. Declared props: children, engaged, variant, idleLabel."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlowButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:accent|danger)$/]",
        "message": "<GlowButton> variant must be one of 'accent' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Keyboard'] > JSXAttribute > JSXIdentifier[name!=/^(?:whites|whiteFill|whitePress|blackFill|blackPress|accent|keyBorder|onPress|onRelease|key|ref|className|style|children)$/]",
        "message": "<Keyboard> doesn't accept that prop. Declared props: whites, whiteFill, whitePress, blackFill, blackPress, accent, keyBorder, onPress, onRelease."
      },
      {
        "selector": "JSXOpeningElement[name.name='Knob'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|size|label|format|unit|sensitivity|key|ref|className|style|children)$/]",
        "message": "<Knob> doesn't accept that prop. Declared props: value, onChange, size, label, format, unit, sensitivity."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|height|gradient|glow|key|ref|className|style|children)$/]",
        "message": "<Meter> doesn't accept that prop. Declared props: value, height, gradient, glow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|width|pad|radius|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, width, pad, radius."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|label|valueLabel|gradient|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: value, onChange, label, valueLabel, gradient."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:product|color|size|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: product, color, size."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
